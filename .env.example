# Set a unique random key before starting in production.
APP_ENV=production
FLASK_SECRET_KEY=

# Development: leave DATABASE_URL unset to use SQLite at ./sumak_erp.db.
# Optional SQLite database file path:
# DATABASE=./sumak_erp.db

# PostgreSQL migrations and integration tests use this separate disposable
# target only; they never fall back to DATABASE_URL.
TEST_DATABASE_URL=
ALLOW_TEST_DATABASE_MIGRATIONS=
# For providers whose test database is named "postgres", allowlist its exact,
# verified non-production hostname (comma-separated if needed).
TEST_DATABASE_HOST_ALLOWLIST=

# Production migration confirmations: set only for an explicit, reviewed
# migration command, not in the long-running WSGI service environment.
ALLOW_PRODUCTION_DATABASE_MIGRATIONS=
PRODUCTION_DATABASE_HOST_ALLOWLIST=
PRODUCTION_DATABASE_NAME=
PRODUCTION_DATABASE_SCHEMA=

# Production: set DATABASE_URL privately to the Supabase PostgreSQL connection
# string. Use the provider's pooler endpoint and TLS options as appropriate.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
