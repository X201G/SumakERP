[Unit]
Description=SumakERP Flask application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sumakerp
Group=www-data
WorkingDirectory=/opt/sumakerp
EnvironmentFile=/etc/sumakerp/sumakerp.env
ExecStart=/opt/sumakerp/.venv/bin/gunicorn --workers 1 --worker-class gthread --threads 4 --bind 127.0.0.1:8000 --access-logfile - --error-logfile - app:app
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
